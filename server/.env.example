# =========================================================
# ArogyaRakshak AI - Server Environment Configuration
# =========================================================
# Set these in your Render Dashboard:
# Service -> Environment -> Add Environment Variable
# =========================================================

# Server Port & Runtime
PORT=5000
NODE_ENV=production

# Frontend Connection Links (for CORS authorization)
# Enter your deployed Netlify domain here:
CLIENT_URL=https://arogyarakshak-ai.netlify.app
FRONTEND_URL=https://arogyarakshak-ai.netlify.app
ALLOWED_ORIGINS=https://arogyarakshak-ai.netlify.app,http://localhost:5173,http://localhost:5000

# Backend Base URL (Used for QR code verification and PDF prescription links)
BASE_URL=https://aroghyarakshak-ai.onrender.com
BACKEND_URL=https://aroghyarakshak-ai.onrender.com

# AI & LLM Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/arogyarakshak?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Emergency & WhatsApp Dispatch (Optional: Twilio / Meta WhatsApp API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
