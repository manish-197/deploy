# ==============================================================================
# ArogyaRakshak AI - Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (NETLIFY)
# Add these in Netlify Dashboard: Site configuration -> Environment variables
# ------------------------------------------------------------------------------
# Backend connection link for the frontend to communicate with Render API:
VITE_API_URL=https://aroghyarakshak-ai.onrender.com
VITE_API_BASE_URL=https://aroghyarakshak-ai.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (RENDER)
# Add these in Render Dashboard: Service -> Environment -> Add Environment Variable
# ------------------------------------------------------------------------------
# Server Port & Runtime
PORT=5000
NODE_ENV=production

# Frontend connection links (for CORS authorization from Netlify):
CLIENT_URL=https://arogyarakshak-ai.netlify.app
FRONTEND_URL=https://arogyarakshak-ai.netlify.app
ALLOWED_ORIGINS=https://arogyarakshak-ai.netlify.app,http://localhost:5173,http://localhost:5000

# Backend Base URL (Used for QR code verification links and PDF documents):
BASE_URL=https://aroghyarakshak-ai.onrender.com
BACKEND_URL=https://aroghyarakshak-ai.onrender.com

# AI & LLM Model Configuration
# NOTE: Gemini 2.5 series is scheduled for shutdown — check ai.google.dev/gemini-api/docs/changelog
# before final submission and migrate GEMINI_MODEL to gemini-3.1-flash-lite or then-current stable model.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/arogyarakshak?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Emergency & WhatsApp Dispatch (Twilio / Meta WhatsApp API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
